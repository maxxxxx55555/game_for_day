	"Проходить интенсив по IT и финансам":"Пройти интенсив",
	"Отдохнуть, выспаться и заняться спортом":"Восстановить силы",
	"Выступить с собственным прототипом":"Представить прототип",
	"Помочь организаторам за фиксированную оплату":"Помочь организаторам",
	"Пропустить мероприятие и отдохнуть дома":"Отдохнуть дома",
	"Пройти полное обследование и лечение":"Пройти лечение",
	"Продолжать работать через силу":"Продолжить работу",
	"Взять недельный отпуск и перейти на домашнюю еду":"Взять отпуск",
	"Взять на себя ответственность":"Принять повышение",
	"Остаться на спокойной должности":"Остаться на должности",
	"Уйти на удаленный фриланс":"Уйти на фриланс",
	"Разработать бота под заказ бизнеса":"Разработать бота",
	"Изучать архитектуру ИИ и алгоритмы":"Изучать ИИ",
	"Восстановить баланс сна и психики":"Восстановить силы",
	"Подписать контракт и работать без выходных":"Подписать контракт",
	"Нанять подрядчиков и разделить прибыль":"Нанять подрядчиков",
	"Отказаться и уехать в оздоровительный отпуск":"Взять отпуск",
	"Выкупить проблемный объект и сдать в субаренду":"Купить недвижимость",
	"Гений алгоритмов":"Аналитик",
	"Железный организм":"Выносливость",
	"Инсайдер Уолл-Стрит":"Инвестор",
	"Антикризисный менеджер":"Антикризисный менеджер",
	"Выбрать черту характера":"Выбрать характер",
	"Начать новую историю":"Начать историю",
	"Вернуться к жизни":"Продолжить жизнь"
}
static func parts(raw:String) -> Dictionary:
	var split:=raw.find(" (")
	var action:=raw.substr(0,split).strip_edges() if split>=0 else raw.strip_edges()
	var detail:=raw.substr(split+2).trim_suffix(")") if split>=0 else ""
	var title:String=ACTIONS.get(action,action)
	# Cost written before the parentheses still has to be visible after an alias.
	if title!=action:
		var money:=RegEx.new()
		money.compile("\\$[0-9][0-9,.]*")
		for match in money.search_all(action):
			var value:=match.get_string()
			if not value in detail: detail=value+(" · "+detail if not detail.is_empty() else "")
	return {"title":title,"detail":detail}
