; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/version="2.0.0"

config/name="Heirs of Fortune"
config/name_localized={"en":"Heirs of Fortune","ru":"Наследники удачи"}
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Forbes Ladder- Dynasty & Markets v2"
config/description="A generational finance strategy game: build a business dynasty and reach the world's top rank."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.067,0.118,0.180,1)

[autoload]

BuildIntegrity="*res://scripts/security/BuildIntegrity.gd"

FortuneArrival="*res://scripts/ui/FortuneArrival.gd"

LocalizationManager="*res://scripts/autoload/LocalizationManager.gd"

GameManager="*res://scripts/GameManager.gd"
SoundManager="*res://scripts/audio/AudioDirector.gd"
EventLibrary="*res://scripts/EventLibrary.gd"

[display]

window/size/window_width_override=540
window/size/window_height_override=960

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
